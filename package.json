{
  "name": "wasla",
  "version": "2.0.0",
  "description": "Turn a title into a URL slug and keep Arabic letters.",
  "license": "MIT",
  "type": "module",
  "author": "Pro Gineous <github@progineous.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/progineousgb/wasla.git"
  },
  "homepage": "https://github.com/progineousgb/wasla#readme",
  "bugs": {
    "url": "https://github.com/progineousgb/wasla/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "prepare": "npm run build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "keywords": [
    "slug",
    "arabic",
    "url",
    "title"
  ]
}
